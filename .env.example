# Fafobot backend configuration.
#
# Copy to `.env` and fill in. `.env` is gitignored; never commit real keys.
# Every value here has a working default except the API keys, so the backend runs
# out of the box with the fake providers and no credentials at all.

# ---------------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# Writes what people say, and what the robot replies, into the logs.
# Development only. Leave false in anything a real person talks to.
LOG_TRANSCRIPTS=false

# ---------------------------------------------------------------------------------
# Role — this one line is how you change what the robot is.
# Must match a filename in roles/ (without .yaml). See docs/ROLE_SYSTEM.md.
# ---------------------------------------------------------------------------------
ROLE_ID=social_companion

ROBOT_NAME=Fafobot
# Optional deployment context injected into the prompt, e.g. "the front desk at Acme".
DEPLOYMENT_VENUE=
DEPLOYMENT_NOTES=

# ---------------------------------------------------------------------------------
# Providers — `fake` needs no credentials and is the default.
# ---------------------------------------------------------------------------------
# fake | openai_compatible
STT_PROVIDER=fake
STT_MODEL=whisper-1
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=

# fake | openai_compatible | gemini
LLM_PROVIDER=fake
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_TEMPERATURE=0.7
LLM_MAX_OUTPUT_TOKENS=300

# Only used when LLM_PROVIDER=gemini. LLM_MODEL selects the Gemini model.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# fake | openai_compatible
TTS_PROVIDER=fake
TTS_MODEL=tts-1
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_VOICE=alloy

# ---------------------------------------------------------------------------------
# Timeouts (seconds). Every AI call has a budget; exceeding it produces a spoken
# apology and returns the robot to listening. It never hangs.
# ---------------------------------------------------------------------------------
STT_TIMEOUT_S=15
LLM_TIMEOUT_S=20
TTS_TIMEOUT_S=20
# Extra time beyond the audio's own duration to wait for the robot's playback_done.
PLAYBACK_GRACE_S=10
SESSION_IDLE_TIMEOUT_S=900

# ---------------------------------------------------------------------------------
# Conversation bounds
# ---------------------------------------------------------------------------------
MAX_HISTORY_TURNS=12
MAX_HISTORY_CHARS=8000
